<h5>Add New Item</h5>
<%= form_for @item do |f| %>
<div class="row">

  <div class="col-6">
    <div class="row">
      <div class="col-2">Name: </div>
      <div class="col-4"><%= f.text_field :name %> </div>
    </div>
    <div class="row">
      <div class="col-2">Type: </div>
      <div class="col-4"><%= f.text_field :item_type %> </div>
    </div>
    <div class="row">
      <div class="col-2">Description: </div>
      <div class="col-4"><%= f.text_area :description, :rows => '5'%> </div>
    </div>

  </div>


</div>

<div class="row">
  <div class="col-12">
     <hr>
    <%=space(10).html_safe%> <%= f.submit %><%=space(5).html_safe%> <%=link_to "Cancel", items_url, :style=>"font-weight:bold"%>
  </div>
</div>
<% end %>
