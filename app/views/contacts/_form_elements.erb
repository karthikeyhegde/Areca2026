<div id='contact_form' class="row" >

  <div class="col-4" >
   <div class="row">
      <div class="col-4">Regual Customer: </div>
      <div class="col-1"><%=f.check_box :regular%> </div>
    </div>
    <br/>
    <div class="row">
      <div class="col-2">Name: </div>
      <div class="col-2"><%= f.text_field :name %> </div>
    </div>
     <br/>
    <div class="row">
      <div class="col-2">Label: </div>
      <div class="col-2"><%= f.text_field :contact_type %> </div>
    </div>
     <br/>
    <div class="row">
      <div class="col-2">Address: </div>
      <div class="col-2"><%= f.text_area :address, :rows => '5'%> </div>
    </div>
   
   
  </div>
  <div class="col-8">
     <div class="row">
      <div class="col-3">Item Supplier: </div>
      <div class="col-1"><%=f.check_box :supplier%> </div>
    </div>
     <br/>
     <div class="row">
      <div class="col-3">Other Name</div>
      <div class="col-2"><%= f.text_field :subname %>  </div>
    </div>
     <br/>
    <div class="row">
      <div class="col-3" style='color:#356635'> Starting Balance (Rs) </div>
      <div class="col-2"><%= f.text_field :starting_balance %><br><br> </div>
    </div>
     <br/>
    <div class="row">
      <div class="col-3">Contact# </div>
      <div class="col-2"><%= f.text_field :contact_number %> </div>
    </div>
     <br/>
    <div class="row">
      <div class="col-3">Contact#(2)</div>
      <div class="col-2"><%= f.text_field :contact_number2 %> </div>
    </div>
     <br/>
     <div class="row">
      <div class="col-3">Place: </div>
      <div class="col-2"><%= f.text_field :place %> </div>
    </div>
    


  </div>

</div>