
<script type="text/javascript">
   function contact_selected(id,name,num,type){

  
    if( type == 'stk'){

      $('#stock_entry_contact_id').val(id);
    $('#stk_contact').val(name);
    $('#contact_number').html("Ph: "+num);
    $('#contact-modal-window').modal('hide');

    }else{
    $('#transaction_contact_id').val(id);
    $('#txn_contact').val(name);
    $('#contact_number').html("Ph: "+num);
    $('#contact-modal-window').modal('hide');
  }
    
    

  }


  </script>
</script>

        <table class="table table-bordered table-striped " style="font-size:12px;">
          <thead>
            <th>Name</th>
            <th>Label</th>
            <th>Contact#</th>
          </thead>
          <tbody>
           <% @contacts.each{ |c| %>
            <tr>
             <td><span class="txt-lnk" onclick="contact_selected('<%=c.id%>','<%=c.name%>','<%=c.contact_number%>','<%=@type%>')"><%=c.name%></span></td>
             <td><%=c.contact_type%></td>
             <td><%=c.contact_number%></td>
           </tr>
           <%}%>
          </tbody>

        </table>
     
