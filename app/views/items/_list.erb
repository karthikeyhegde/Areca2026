<table class="table table-striped table-condensed table-sm" style='font-size:13px;width:90%' align="center">
  <thead style="background-color:#e69138;">
    <th>Item Name</th>
    <th>HSN Code</th>
    <th>Reference Price</th>
    <th>Description</th>
    <th>Stock</th>
    <th style="color:#330099">Refresh</th>
    <th style="color:#330099">Action</th>
  </thead>
  <tbody>
   <% i = 0
    @items.each{|c|
     i+= 1 %>
     <tr>
     
      <td><%=link_to c.name, rep_txnitems_item_url(c.id)%></td>
      <td><%=c.hsn_code%></td>
       <td><%=c.reference_price%></td>
       <td><%=c.description%>
      <td><%=c.current_stock%></td>
      <td><%=link_to "Refersh Stock", stock_refresh_item_url(c.id), :class=>"btn btn-sm btn-success"%><%=space(5).html_safe%></td>
    <td>
          <span id ='t1'>
          <%=link_to "Edit", edit_item_url(c.id), :class=>"label label-info"%><%=space(5).html_safe%>
         </span>
         <span id='t2'>
          <%=link_to "Delete", remove_item_url(c.id), :method => :post, :onclick => "return confirm('Are you sure?')", :class=>"label label-warning"%>
         </span>
      </td>
   </tr>
   <%}%>
  </tbody>

</table>
