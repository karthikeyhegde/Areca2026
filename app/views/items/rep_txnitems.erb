
<div class="row">
  
  <div class="col-3 offset-1"><h5><%=@item.name%>  <span class="greytext">- Transactions</span></h5></div>
  <div class="col-4">
    <%=form_tag filter_rep_txnitems_items_path do%>
        <%=text_field_tag :sdate, params[:sdate], {class: 'report-date', style:'height:25px;width:120px;', :placeholder => "From Date"}%>
       <input type="hidden" name="id" value="<%=@item.id%>"/>
       <span style="font-size:18px;"> - </span>
      
        <%=text_field_tag :edate, params[:edate], {class: 'report-date', style:'height:25px;width:120px;', :placeholder => "To Date"}%>
          <%=submit_tag "Show" , {class:'btn btn-primary btn-xs', style:'vertical-align: top;', :onclick => "$('#myspinner').show()"}%>
          <span id='myspinner' style="display:none;"><%=image_tag "ajax-loader.gif"%></span>
    <%end%>
  </div>
  <div class="col-4 float-right" style="font-weight: 350;">
       &nbsp;&nbsp;Total items : <%=@all_numbers%>
        &nbsp;&nbsp;
       Total Amount: <%=@all_sum%>
     </div>
 </div>

<div id="trs" class="row">
   <div class="col-12">
<table class="table zebra-striped " style='font-size:13px;width:90%;font-weight: 400' align="center">
  <thead style="background-color:#2874A6;color:#FFFFFF">
    <th>Date</th>
    <th>Txn</th>
    <th>Site</th>
    <th>Contact</th>
    <th>Number / Price<br/>
        
    </th>
    <th>Amount</th>
    
  </thead>
  <tbody>
   <% i = 0
    @txn_items.each{|c|
     i+= 1 %>
    <%if i%2 == 0%>
       <tr>
    <%else%>
       <tr class="table-info">
    <%end%>
    <td><%=c.on_date%></td>
    <td>
      <%=link_to c.transaction_id, edit_tranxn_url(c.transaction_id), :class=>"label label-info"%>
    </td>
    <td><%=c.tranxn.site_name%></td>
    
    <% p '======'%>
    <% p c.id%>
   <% p c.contact %>
    <td><%if !c.contact.nil? %><%=link_to c.contact_name,report_page_contact_path(c.contact_id) %><%end%></td>

    <td><%=c.ui_number%>&nbsp x &nbsp;<%=c.price%></td>
    
    <td> <%=c.ui_amount%></td>
          
   </tr>
   <%}%>
   <tr class="table-secondary">
    <td><b>Total</b></td>
    <td></td>
    <td></td>
    <td></td>
    <td><%=@all_numbers%></td>
    
    <td> <%=@all_sum%></td>
          
   </tr>
  </tbody>

</table>
   </div>
</div>

<script type="text/javascript">

$('.report-date').datepicker({ dateFormat: 'dd-mm-yy',
    beforeShow: function (textbox, instance) {   
                instance.dpDiv.css({
                    marginTop: (-textbox.offsetHeight+30) + 'px'
                    
                });
            }

 });


</script>
