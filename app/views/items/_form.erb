<h5>Add New Item</h5>
<%= form_for @item do |f| %>
<div class="row">

  <div class="col-8">
    <div class="row">
      <div class="col-4">Name: </div>
      <div class="col-4"><%= f.text_field :name %> </div>
    </div>
    <br/>
    <div class="row">
      <div class="col-4">Type: </div>
      <div class="col-4"><%= f.text_field :item_type %> </div>
    </div>
    <br/>
    <div class="row">
      <div class="col-4">Description: </div>
      <div class="col-4"><%= f.text_area :description, :rows => '5'%> </div>
    </div>
    <br/>

     <div class="row">
      <div class="col-4">Starting Stock: </div>
      <div class="col-4"><%= f.text_field :starting_stock, :style =>"height:30px;"%> </div>
    </div>
    <br/>
    <div class="row">
      <div class="col-4">HSN Code: </div>
      <div class="col-4"><%= f.text_field :hsn_code, :style =>"height:30px;"%> </div>
    </div>
    <br/>
    <div class="row">
      <div class="col-4">Reference Price: </div>
      <div class="col-4"><%= f.text_field :reference_price, :style =>"height:30px;"%> </div>
    </div>
     <br/>
  </div>


</div>

<div class="row">
  <div class="col-12">
     <hr>
    <%=space(10).html_safe%> <%= f.submit %><%=space(5).html_safe%> <%=link_to "Cancel", items_url, :style=>"font-weight:bold"%>
  </div>
</div>
<% end %>
