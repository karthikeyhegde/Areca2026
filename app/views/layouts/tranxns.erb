<html>
<head>

    <title>Areca</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'custom', defer: false, 'data-turbolinks-track': 'reload' %>
    
  <script type="text/javascript">
     
     var search_contacts = [];
     var contact_names = []
    $(document).on('keyup','input.item_numbers', {} ,function(e){
       var num =  this.id.split("_")[2];
      var price_e = $("#item_price_"+num)[0];
      var number_e = $("#item_number_"+num)[0];
      var tax_perc_e = $("#item_taxpercentage_"+num)[0];
      console.log(" --- ")
      console.log(tax_perc_e)
      var regexDecm =  /^[1-9]\d*(\.\d+)?$/;
      var regexNum =   /[0-9 -()+]+$/ ;
      var effective_price;
     
      if(price_e.value.match(regexDecm) && number_e.value.match(regexNum)){
        effective_price = parseFloat(price_e.value);
        if(tax_perc_e.value.match(regexDecm)){
           
         effective_price =  effective_price + ( effective_price * (parseFloat(tax_perc_e.value)/100) )
        }


        $("#item_val_"+num).html(indianFormat((parseFloat(price_e.value) * parseFloat(number_e.value)).toFixed(2)));

      }else{ $("#item_val_"+num).html('0') }
      
      calc_total_value();

    });




   function calc_total_value(){

       var  i =1;
       var total = 0.0;

       $(".item_total").each(function(){
          if($(this).html() != ''){
            var st = $(this).html().split(',').join('');
            var a = parseFloat(st);
            total = total+a;
          }
       });


     
    if($("#tranxn_other_charges_amount")[0] && $("#tranxn_other_charges_amount")[0].value != '') {
        total = total+ parseFloat($("#tranxn_other_charges_amount")[0].value);
      }


      if( $("#tranxn_vehicle_charges")[0] && $("#tranxn_vehicle_charges")[0].value != '') {
        total = total+ parseFloat($("#tranxn_vehicle_charges")[0].value);
      }

      if($("#tranxn_hamaali")[0] && $("#tranxn_hamaali")[0].value != '') {
        total = total+ parseFloat($("#tranxn_hamaali")[0].value);
      }
      
      if( $("#tranxn_discount")[0] && $("#tranxn_discount")[0].value != '') {
        total = total - parseFloat($("#tranxn_discount")[0].value);
      }

      ptotal = parseFloat(total).toFixed(2);
      numtxt = indianFormat(ptotal);
      $("#items_total_value").html(numtxt);    

   }

   function removeItem(row_no){
     $("#trow_"+row_no).remove();
     calc_total_value();

   }  

   
   function search_contacts_call(id){
       a =  $("#"+id)[0].value;
       contact_names = [];
       $.ajax({
         type:"Get",
         dataType: 'json',
         url: "<%=search_names_contacts_path()%>",
         data:"str="+a ,
         success: function(data){
           $.each(data, function(i,val){
              contact_names.push(val.name+"  "+val.subname);
           });
           search_contacts = data;
           
         }
       });
       
       return contact_names;

   }

   function show_other_fields(){

     $("#other_link").hide();
     $("#vehicle").show();
     $("#hamaali").show();
     $("#discount").show();
   }

  function indianFormat(amount) {
  var delimiter = ","; // replace comma if desired
  amount = new String(amount);
  var a = amount.split('.',2);
  var dec = ''
  var k = a[0]
  var istr =  k.split('').reverse().join('');

  if(a[1].length > 0){
      dec = '.'+a[1]
  }
  var ln = a[0].length -1
  i =0;

   var rn_str = '';
   while ( i <= ln ){
        if ( i == 3  || ( i > 4 && i%2 == 1)){
           rn_str += ','
        }

        rn_str += istr[i];
        i++;

   }
   rs = rn_str.split('').reverse().join('');
   return rs+dec
   
}

$(document).on('keyup','input.item_numbers', {} ,function(e){
   var num =  this.id.split("_")[2];
   var price_e = $("#item_price_"+num)[0];
   var number_e = $("#item_number_"+num)[0];
   var tax_perc_e = $("#item_taxpercentage_"+num)[0];
   console.log(" --- ")
   console.log(tax_perc_e)
   var regexDecm =  /^[1-9]\d*(\.\d+)?$/;
   var regexNum =   /[0-9 -()+]+$/ ;
   var effective_price;

   if(price_e.value.match(regexDecm) && number_e.value.match(regexNum)){
     effective_price = parseFloat(price_e.value);
     if(tax_perc_e.value.match(regexDecm)){
        
      effective_price =  effective_price + ( effective_price * (parseFloat(tax_perc_e.value)/100) )
     }

     $("#item_val_"+num).html(indianFormat((effective_price * parseFloat(number_e.value)).toFixed(2)));
   }else{ $("#item_val_"+num).html('0') }
   
   calc_total_value();

 });
 
  </script>
</head>
<body>
<%=render :template => "layouts/new_nav" %>
<div class="container-fluid">
  <div class="row" style="padding:1px">
    <div class="col-12"style="text-align:left" id="tranxns">
    <br><br><br>
          <%=yield%>
    </div>


  </div>

</div>

</body>

</html>
