<% txitem = TxnItem.new() 
   txitem.id = row_no.to_i
%>
<tr id="trow_<%=row_no%>" class='item_area'>
<%= fields_for "txn_items[]", txitem do |t| %>

<td style="padding:6px;border:0; padding-left:10px;" class='item_arr_no'>
     <%=image_tag "cross_circle.png", :size=>"14x14", :onclick => "removeItem('#{row_no}')",  style:'font-size:12px;font-weight:bold;'%>&nbsp;
     <%=t.select  :item_id, options_for_select(["Select .."]+Item.picklist), :style=>"width:100px;"%>
</td>
<td style="padding:1px;padding-top:8px;border:0;" class='item_arr_no' > 
     <%=t.text_field :number,  id:"item_number_#{row_no}",class:"item_numbers", :style=>"height:30px;width:80px;" , :placeholder =>"Numbers" %>

     <%=space(4)%>
     <%=t.text_field :price, id:"item_price_#{row_no}", class:"item_numbers", :style=>"height:30px;width:80px;", :placeholder => "Price" %>
     <%=space(6)%>
     <%=t.text_field :tax_percentage, id:"item_taxpercentage_#{row_no}", class:"item_numbers", :style=>"height:30px;width:40px;", :placeholder => "Tax" %>%

     </td>
<td style="padding:1px;padding-top:8px;border:0;padding-left:50px" class='item_arr_no' colspan='3'>
<span id='item_val_<%=row_no%>' class='item_total'></span>
     <span id='item_stock_<%=row_no%>'style='color:grey;font-size:11px;font-weight:bold;padding-left:30px;'></span>

</td>
 
 <%end%>
 <tr>

 <script type="text/javascript">
  item_stocks = {}
 var rownumber = "<%=row_no%>"
 items_test_id = "<%=@items[0].id%>"
 console.log("row number "+rownumber);
  console.log("From JS number "+items_test_id);

 <% @items.each{|it| %>
 itm_id = "<%=it.id%>"
 itm_stock = "<%=it.current_stock%>"
 item_stocks["<%=it.id%>"] = "<%=it.current_stock%>"

<%}%>

 $('#txn_items_<%=txitem.id%>_item_id').select2({
    width:'210px',

 });

 $('#txn_items_<%=txitem.id%>_item_id').on('change', function() {
   // Get the selected value
   var selectedId = this.value;
   console.log("select itm ---- ");
   
    selectid_splits = this.id.split("_");
    thisrow = selectid_splits[2];
    console.log(selectid_splits[2]);
    
   $.ajax({
      url:     "item_current_stock", 
      type:     "POST",
      headers: { "Accept": "application/json" , 'X-CSRF-Token': $('meta[name="csrf-token"]').attr('content')},
      dataType: "json",
      data:    { 'id' : selectedId  },
      success: function(response){
                let dataMap = response.data; 
                console.log(dataMap.currentStock);
                
                console.log("In res "+rownumber);
                $("#item_stock_"+thisrow).text("Stocks: "+dataMap.currentStock);
               },
      error: function(xhr, status, error) {
         console.error("AJAX Error:", status, error, xhr.responseText);
         }           
      });                   
   
});

$(document).on('keyup','input.item_numbers', {} ,function(e){
   var num =  this.id.split("_")[2];
   var price_e = $("#item_price_"+num)[0];
   var number_e = $("#item_number_"+num)[0];
   var tax_perc_e = $("#item_taxpercentage_"+num)[0];
   console.log(" --- ")
   console.log(tax_perc_e)
   var regexDecm =  /^[1-9]\d*(\.\d+)?$/;
   var regexNum =   /[0-9 -()+]+$/ ;
   var effective_price;

   if(price_e.value.match(regexDecm) && number_e.value.match(regexNum)){
     effective_price = parseFloat(price_e.value);
     if(tax_perc_e.value.match(regexDecm)){
        
      effective_price =  effective_price + ( effective_price * (parseFloat(tax_perc_e.value)/100) )
     }

     $("#item_val_"+num).html(indianFormat((effective_price * parseFloat(number_e.value)).toFixed(2)));
   }else{ $("#item_val_"+num).html('0') }
   
   calc_total_value();

 });
 

 </script>