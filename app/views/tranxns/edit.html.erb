<div id='contact-modal-window' class="modal hide fade" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
</div>

<%= form_for @trans, :remote => true, :html =>{:id=>'transaction_form'} do |f| %>
  
   <div id='Header' class="row-fluid txn-form">
     <div class="col-10 offset-2" >
     <h4>Edit Transaction <%=@trans.id%></h4>
     </div>
   </div> 

 <div id='div_item_table' class="row txn-form" style="border:0;">
    <div class="col-10 offset-1">

        <table id='item_tb' class=' nb-table' style="border:1px solid #e6e6e6; background-color: #f1f1f1; width:90%">
      <thead style="font-size:12px;">
      </thead> 
      <tbody style='font-size:13px;'>
         <tr id='first_row_fields' >
             <td style="width:20%;padding:20px;padding-bottom:10px;font-size:16px;padding-left:30px;""> Date : <%=@trans.on_date%></td>
             <td  style="width:40%;padding-bottom:1px;font-size:16px;padding-top:10px;">  <%=@trans.contact.name_subname%>
                <%=f.hidden_field :contact_id %>
                <br>
                <span id='contact_number' style='color:grey;font-size:14px;'><%=@trans.contact.contact_number%></span>
             </td>
             <td style="padding-left:50px;padding-top:10px;">Site:  <%=link_to ((image_tag "find.png", :size=>"16x16")+" List"), window_list_sites_path,  {:remote => true, 'data-toggle' =>  "modal", 'data-target' => '#contact-modal-window', style: 'font-size:12px;font-weight:bold;'}  %> <br>
               <%=text_field :txn, :site, class:'autocomplete', style:"height:30px;", :value => @site_name%> <br>
               <%=f.hidden_field :site_id %>
             </td>
          </tr>
             


       <% @row_no ||= -1 %>
         <tr>
           <td id='item_th' style="border-top:0px;width:25%;font-size:16px;padding:8px;">
           &nbsp;<%=link_to ((image_tag "add.png", :size=>"14x14")+' Item'), add_item_row_tranxns_path(:no => @row_no ), :remote => true%></td>
           <td></td>
           <td></td>
         </tr> 
       
        
        <%@trans.txn_items.each  do |item| %>
           <%= fields_for "txn_items[]", item do |t| %>
            <tr id="trow_<%=item.id%>" class='item_area'>
                <td style="padding:10px;" class='item_arr_no'>
                 <%=link_to  (image_tag "cross_circle.png", :size=>"14x14"),"#" , :onclick => "removeItem('#{item.id}')", style:'font-size:15px;font-weight:bold;'%>
                    <%=t.select  :item_id,  options_for_select(["Select ..",'']+Item.all.collect{|c| [c.name,c.id]},["#{item.item.name} ", item.item_id ]), {}, {id:"item_select_#{item.id}",class:'item-select'} %>

                </td>
                
               <td style="padding:1px;padding-top:8px;border:0;" class='item_arr_no' > 
                 <%=t.text_field :number, id:"item_number_#{item.id}", class:"item_numbers", :style=>"width:80px;height:30px;" %>
                   <%=space(4)%>
                   <%if item.tax_percentage.to_f == 0 %>
                     <%=t.text_field :price, id:"item_price_#{item.id}",  class:"item_numbers", :style=>"height:30px;width:80px;"%> 
                   <%else%>
                      <%=t.text_field :price_before_tax, id:"item_price_#{item.id}",  class:"item_numbers", :style=>"height:30px;width:80px;"%> 
                   <%end%>
                     <%=space(6)%>
                   <%=t.text_field :tax_percentage, id:"item_tax_percentage_#{item.id}",  class:"item_numbers", :style=>"height:30px;width:40px;"%>%
               </td>
              <td style="padding:1px;padding-top:8px;border:0;padding-left:50px" colspan='3'>
                 <span id='item_val_<%=item.id%>' class='item_total'> <%= Utility.indian_number item.amount%></span>
              </td>
             </tr>
         <%end%>
       <%end%>
        
        
        <tr id='others_row'>
          <td style='border-top:0px;padding:10px;padding-left:16px;'> Vehicle Rental: <br> 
             <%=f.text_field :vehicle_charges, style:'height:30px;', :class=>'calc-amount'%>
          </td>
          <td style='border-top:0px;padding:2px;' colspan="2">
            Hamaali: <%=space(9)%> Discount:  <%=space(6)%> Other Charges:
            <br> 
            <%=f.text_field :hamaali, style:'height:30px;width:70px;', :class=>'calc-amount'%>
            <%=space(5)%>
            <%=f.text_field :discount, style:'height:30px;width:70px;', :class=>'calc-amount'%>
            <%=space(5)%>
            <%=f.text_field :other_charges_amount, style:'height:30px;width:70px;', :class=>'calc-amount' %>

          </td>
          </tr>
          <tr>
             <td style="border-top:0px;"></td>
             <td style="font-size:13px;text-align:right;padding-right:75px;"><br><b>Total Amount</b></td>
             <td style="padding-left:50px;"> <span id='items_total_value'  style='padding-top:20px;'><%= Utility.indian_number @trans.amount%></span></td>
         
        </tr>

    <tr>

    <tr id='gap_row_3' >
            <td style="padding:10px;border-bottom: 1px solid #E6E6E6;" colspan="3"></td>
           </tr> 
      <td style="padding:20px;">
      Payment Type
       <br>
     <%=f.select  :payment_type, options_for_select([['Cash','Cash'],['Cheque','Cheque'],['Bank Transaction']],[@trans.payment_type,@trans.payment_type] ),{},{style:'width:150px;'}%>
     
      </td>

     <td>
       Paid Amount 
        <br>
        <%=f.text_field  :payment_amount, style:'height:30px;'%>
   </td>
     <td style="padding-left:80px;">
       <span  class="label "> Return: <%=f.check_box :buyback %> </span>
     </td>
</tr>  

<tr>
<td id='add_note' style="padding-left:10px;">
  <span class="txt-lnk" onclick="$('.t_note').show();$('#add_note').hide();">
    <%=image_tag "add.png", :size=>"11x11"%> Note and Other info
  </span>
</td>
<td class='t_note' style="padding-left:20px;display:none;"> Note:<br><%=f.text_area  :descri , cols:25, rows: 4 %></td>

<td class='t_note' style="display:none;" >Vehicle Num:<br> <%=f.text_field  :vehicle_number,  style:'height:30px' %>
</td>
<td class='t_note' style="display:none;padding-left:10px;">Bill Num:<br><%=f.text_field  :bill_number, style:'height:30px' %></td>
</tr>


 <tr id='gap_row_3' >
            <td style="padding:10px;border-bottom: 1px solid #E6E6E6;" colspan="3"></td>
           </tr> 

<tr>
    <tr>
     <td style="padding:20px;padding-right:0px;" colspan="3"><ANCDFG>
        <%=submit_tag 'Update Transaction',  class:'btn btn-warning', :data => {disable_with: "Saving ..."}, id:'tx-btn'%><%=space(5).html_safe%> <%=link_to "Cancel", tranxns_url, :style=>"font-weight:bold"%>
       </td>
       
       <td  colspan="2"><%=link_to "X Delete", remove_tranxn_url(:id => @trans.id, :show_page => 'report_page'), :method => :post,  :confirm => "Transaction #{@trans.id} will be deleted permanently !!  Are you Sure ?", :class=>"label label-warning"%></td>
       <tr>
      </tbody>  

  </table>
<% end %>

<script type="text/javascript">

$('.item-select').select2({
    width:'210px',

 });

$('#transaction_on_date').datepicker({ dateFormat: 'dd-mm-yy' });

$('.calc-amount').on('keyup', function(){
    
     calc_total_value();

   });
  var contact_names = [];
  var search_contacts = {};
  var site_names = [];
  var search_sites = [];

  $('#txn_contact').autocomplete({
    minLength: 2,
    source: function (request,response){
               a =  $("#txn_contact")[0].value;
               $.ajax({
               type:"Get",
               dataType: 'json',
               url: "<%=search_names_contacts_path()%>",
               data:"str="+a ,
               success: function(data){
                contact_names = [];
                search_contacts = {};
                 $.each(data, function(i,val){
                    n_name = (val.subname == null ? val.name:val.name+" "+val.subname)
                    contact_names.push(n_name);
                    search_contacts[n_name] = val;
                 });
                   
               }
             });
              response(contact_names);
           },
    select: function( event, ui ) { 
              
                $('#transaction_contact_id').val(search_contacts[ui.item.value].id.toString());
                 $('#contact_number').html("Ph: "+search_contacts[ui.item.value].contact_number)

              }       

  });


  $('#txn_site').autocomplete({
    minLength: 2,
    source: function (request,response){
               a =  $("#txn_site")[0].value;
               $.ajax({
               type:"Get",
               dataType: 'json',
               url: "<%=search_names_sites_path()%>",
               data:"str="+a ,
               success: function(data){
                site_names = [];
                search_sites = {};
                 $.each(data, function(i,val){
                    site_names.push(val.name);
                    search_sites[val.name] = val.id;
                 });
                   
               }
             });
              response(site_names);
           },
     select: function( event, ui ) { 
      $('#transaction_site_id').val(search_sites[ui.item.value].toString());}       

  });


$('#txn-btn').click(function(){
    $(this).attr('disabled', true);
});
 
 
</script>

