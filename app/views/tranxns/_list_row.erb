  <% i = 0 
      @contact_id ||= '0'

      if @contact_id.to_i == 0
        page_url = "rep_txnitems"
       else
         page_url = "contact_txnitems"
       end 
       site_balance = 0
       
    @trs.each{|c|
     i+= 1 %>
     <% print c.id %>
    <%if i%2 == 0%>
        <tr id="trans_tr_<%=c.id%>">
    <%else%>
       <tr class="table-info" id="trans_tr_<%=c.id%>">
    <%end%>

    <td>
        <% if c.trans_type == 'payment' %>
            <%=link_to c.id, edit_payment_url(c.id), :class=>"label label-info"%><%=space(2).html_safe%>
        <%else%>
            <%=link_to c.id, edit_tranxn_url(c.id), :class=>"label label-info"%><%=space(2).html_safe%>
        <%end%>
    </td>
    <td><%=c.on_date%></td>
    <td><%=link_to c.name_subname, report_page_contact_path(:id => c.contact_id)%>
    </td>
    <td>
        <%if !c.site.blank? %>   
            Site : <%=link_to c.site.name, Rails.application.routes.url_helpers.send("#{page_url}_site_path", :id => c.site.id, :contact_id => @contact_id)%><br/>
        <%end%>
      <% if !c.descri.blank? %>
       <%=c.descri%>
        <br/>
      <%end%> 
       <% if c.buyback == 1%>
           Items Returned
           <b/r>
        <%end%> 
         <%if !c.vehicle_number.blank? %>
          Vehicle No: <%=c.vehicle_number%>
          <br/>
         <%end%> 
         <%if !c.bill_number.blank? %>
          Bill No: <%=c.bill_number%>
         <%end%>

    </td>
    <td>

      <% if c.trans_type == 'payment'  %>
        <%if c.recieved == 0 %>
          PAYMENT PAID
          <%else%>
           PAYMENT RECIEVED
         <%end%>
       </br>
         <%c.payment_rows.each {|p| %>
            <%=p.pay_type%> : <%if !p.note.blank?%> <%=p.note%>  : <%end%> <%=Utility.indian_number p.amount%> <br>
         <% }%>

      <% else %>
        <%c.txn_items.each{|tx|%>
          <% if !tx.tax_percentage.nil? %>
            <%=tx.item_name%> &nbsp;&nbsp; <%=tx.number_price_tax_total%>
          <%else%>
            <%=tx.item_name%> &nbsp;&nbsp; <%=tx.number%> &nbsp;x&nbsp;<%=tx.price%> 
          <%end%>  
         <br>
        <%}%>
        <%if c.hamaali.to_f > 0%>
          Hamaali &nbsp&nbsp <%=c.hamaali%>
          <br>
        <%end%>
        <%if c.vehicle_charges.to_f > 0%>
          Vehicle charges &nbsp&nbsp <%=Utility.indian_number c.vehicle_charges%>
          <br>
        <%end%>
        <%if c.other_charges_amount.to_f > 0%>
          Other charges &nbsp&nbsp <%=Utility.indian_number c.other_charges_amount%>
          <br>
        <%end%>
      <%end%>
      <%if c.discount.to_f > 0%>
        Discount &nbsp&nbsp <%=Utility.indian_number c.discount%>
      <%end%>
      
      </td>
    <td> <% if c.trans_type != 'payment' %>
          <% if c.buyback == 1%> - <%end%>
          <%= Utility.indian_number c.amount%>
          <% site_balance += c.amount %>
        <%end%>
    </td>
    <td>
       <%=  Utility.indian_number c.payment_amount%>
       <% if !c.payment_amount.blank? %>
       <% site_balance -= c.payment_amount %>
       <%end%>
    </td>
    <%if !@site.nil? %>
    <td><%=Utility.indian_number site_balance%></td>
    <%end%>

    <td>
         <span id='t2' title="Remove Txn <%=c.id%>">
          <%=link_to "x", remove_tranxn_url(c.id), method: :post, class: "btn btn-danger btn-xs", data:{confirm: "Transaction #{c.id} will be deleted permanently !!  Are you Sure ?", disable_with: "Processing..."
        }%>
         </span>
      </td>
   </tr>
   <%}%>