<%= form_for @report,  :url => @urlval, :remote => true, :html =>{:id=>"#{@blockstr}"} do |f| %> 
<div class="row" id="filter_form_<%=@blockstr%>">
              
                    <div id='date-options' class="col-4" style="margin:1px;">
                        <div id='custom_dates'  >
                        <span class='sub_head'> Custom Fixed Date</span>
                        <br>
                        <%=f.text_field :from_date,  {class: @date_class, style:'height:30px;width:100px;', :placeholder => "From Date"}%>
                       - <%=f.text_field :to_date,  {class: @date_class, style:'height:30px;width:100px;', :placeholder => "To Date"}%>
                       </div>

                      <div id='OR' style="margin:3px;">
                        <br>
                        <span class='sub_head' style="color:brown"> OR</span>
                        <br><br>
                      </div>

                      <div id='dynamic_dates'  style="margin:3px;">
                        <span class='sub_head'> Dynamic Dates</span>
                        <br>
                        Select Last<br>
                         <%=f.text_field  :number_of, {:style => 'width:60px;height:30px;'} %> -

                        <%=f.select  :dynamic_date_value,  options_for_select([ "","Days","Weeks","Months","Year"],@report.dynamic_date_value), {},{style:'height:30px;width:120px;'}%>
                      </div>
                  </div>

                  <div id="selection-options" class="col-5" >
                      <span class='sub_head'> Filter Criteria</span><br>
                       <span style="font-weight:bold;">Select Items<br>
                         <% t_arr  = @report.item_ids.blank? ? [] : @report.item_ids.split(",") %>
                         <%=f.select  :item_ids, options_for_select(Item.picklist,t_arr), {},{ :multiple => true,:class => "selec2class"} %>
                         <br>
                         Select Contacts<br>
                         <% c_arr  = @report.contact_ids.blank? ? [] : @report.contact_ids.split(",") %>
                         <%=f.select  :contact_ids, options_for_select(Contact.picklist,c_arr), {},{:multiple => true,:class => "selec2class"} %>
                         <br>
                         Select Sites<br>
                         <% st_arr  = @report.site_ids.blank? ? [] : @report.site_ids.split(",") %>
                         <%=f.select  :site_ids, options_for_select(["Select .."]+Site.picklist,st_arr),  {}, {:multiple => true,:class => "selec2class"} %>
                       </span>
                  </div>  
            </div>
            <br>
                  <hr style="margin:1px;">
             <div class="row"  id='sales_filter_buttons'  style="font-size:11px;margin:0px;padding:0px;">
             
                <div id='button_ids' class="col-12" style="margin:2px;border-right: 2px solid #FFF">
                   <%=submit_tag 'Show',  class:'btn  btn-info btn-small', :data => {disable_with: "Saving ..."}, id:'tx-btn'%><%=space(5).html_safe%>
                   <%=submit_tag 'Save as',  class:'btn btn-info btn-small', :data => {disable_with: "Saving ..."}, id:'tx-btn'%>
                   <%=f.text_field :name,  { style:'height:25px;width:150px;padding-top:2px;margin:0px;', :placeholder => "Filter Name"}%>
                </div>

              </div>
<%end%> 
<script type="text/javascript">
  $('#<%=@blockstr%> #report_from_date').datepicker({ dateFormat: 'dd-mm-yy' });
  $('#<%=@blockstr%> #report_to_date').datepicker({ dateFormat: 'dd-mm-yy' });
  

     $('#<%=@blockstr%> #report_site_ids').select2({
    width:'60%',
    maximumSelectionSize: 3

 });
  $('#<%=@blockstr%> #report_item_ids').select2({
    width:'60%',
    maximumSelectionSize: 3

 });
  $('#<%=@blockstr%> #report_contact_ids').select2({
    width:'60%',

 });


$('#<%=@blockstr%> #report_group_order').select2({
    width:'95%',
    maximumSelectionSize: 3
 });

</script>